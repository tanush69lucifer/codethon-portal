# ---- Copy to .env and fill in. Never commit .env ----
APP_NAME=Codethon Portal
NODE_ENV=development
PORT=5000

# Local dev: mongodb://127.0.0.1:27017/codethon
# docker compose: mongodb://mongo:27017/codethon (already set in docker-compose.yml)
MONGO_URI=mongodb://127.0.0.1:27017/codethon

# Long random string:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=10h

# Public URL candidates open (no trailing slash). Used for CORS and the SEB check.
PUBLIC_URL=http://localhost:5173
# Extra allowed origins, comma separated (optional)
CORS_ORIGINS=http://localhost:5173,http://localhost:5000

# Admin account created/updated automatically when the API boots
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# ---- Judge worker ----
# docker = sandboxed containers (REQUIRED for the real contest). local = no sandbox, dev only.
JUDGE_MODE=docker
JUDGE_IMAGE=codethon-java-runner:latest
# Parallel jobs per worker process. Rule of thumb: number of CPU cores - 1.
JUDGE_CONCURRENCY=3
JUDGE_JVM_GRACE_MS=600
JUDGE_CONTAINER_MEMORY_MB=768

# ---- Domain for HTTPS (used by Caddy in docker-compose) ----
DOMAIN=contest.example.com
